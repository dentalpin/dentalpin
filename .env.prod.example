# DentalPin — production. Copy to .env next to docker-compose.prod.yml.

# Public address of your install. Use https:// with a domain that already
# points at this server and Caddy provisions TLS on first boot.
# For a local trial, leave it as http://localhost.
PUBLIC_URL=https://clinic.example.com

# Pin a release in production - never track 'latest', it makes upgrades
# untraceable. Tags carry no 'v' prefix; the current ones are listed at
# https://github.com/dentalpin/dentalpin/releases
DENTALPIN_VERSION=2.4.0

# Database
POSTGRES_DB=dental_clinic
POSTGRES_USER=dental
POSTGRES_PASSWORD=

# Generate each with: openssl rand -hex 32
SECRET_KEY=
BUDGET_PUBLIC_SECRET_KEY=

# Error tracking (optional). Sentry-protocol DSN — Sentry or self-hosted
# GlitchTip. Empty = off. No bodies, cookies, IPs or URL identifiers are
# sent; a cloud backend still needs a DPA (docs/technical/compliance-posture.md).
SENTRY_DSN=

# AI Copilot (optional). Without it the app runs, the assistant does not.
OPENAI_API_KEY=

# Leads module — public intake endpoint (POST /api/v1/leads/public/intake).
# Request size ceiling only; the per-clinic daily cap lives in the database
# (Settings -> Integrations -> "Formulario web").
LEADS_INTAKE_MAX_BODY_KB=8

# Load the demo clinic on first boot to look around before going live.
# admin@demo.clinic / demo1234. Leave at 0 for a real clinic.
SEED_ON_STARTUP=0
SEED_LANG=es
