FROM node:20-alpine AS builder

ARG API_BASE_URL=http://localhost:8000
ENV API_BASE_URL=$API_BASE_URL

WORKDIR /app

COPY frontend/package*.json ./
RUN npm install --no-audit --no-fund

COPY backend/app/modules /module_layers

COPY frontend/ ./

# Bake every module layer. The committed modules.json only mirrors the
# dev checkout's installed set; a prod image can't rebuild when a module
# is installed later, so ship all layers and let the backend's
# `/modules/-/active` decide what is visible at runtime.
RUN node scripts/modules-json.mjs /module_layers

# ponytail: 34 module layers × growing locale set pushed the Nitro build past 4GB
ENV NODE_OPTIONS="--max-old-space-size=6144"
RUN npm run build


FROM node:20-alpine

WORKDIR /app

COPY --from=builder /app/.output /app/.output

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=3000

EXPOSE 3000

CMD ["node", ".output/server/index.mjs"]
