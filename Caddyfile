# Single origin for the whole app. PUBLIC_URL doubles as the site
# address: give it an https host and Caddy provisions the certificate
# itself; leave it at http://localhost and it serves plain HTTP.
# A port in PUBLIC_URL is the port Caddy listens on inside the container:
# http://192.168.1.10:8080 needs "8080:8080" in compose, not "8080:80".

{$PUBLIC_URL:http://localhost} {
	handle /api/* {
		reverse_proxy backend:8000 {
			# The copilot streams SSE; without this Caddy buffers the
			# response and the chat appears frozen until the turn ends.
			flush_interval -1
		}
	}

	handle /health* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}

	encode gzip

	# Basic security headers. Only frame-ancestors from CSP here: the full
	# document policy is set by the frontend itself (Nitro middleware,
	# NUXT_CSP_MODE — see docs/technical/security-csp.md, #355) so the e2e
	# job enforces the same policy prod ships. Two CSP headers on a page
	# are enforced as their intersection, which is intended.
	#
	# The public booking page (/p/booking/<clinicId>) is the one route a
	# clinic may embed in an iframe on its own website: its frame-ancestors
	# comes from the clinic's embed_origins setting, set by the frontend
	# (server/middleware/booking-embed.ts), so Caddy must not add 'self' on top.
	@not_embeddable not path /p/booking/*
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
	header @not_embeddable Content-Security-Policy "frame-ancestors 'self'"
}
