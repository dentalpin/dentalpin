# Database (for Docker Compose)
POSTGRES_DB=dental_clinic
POSTGRES_USER=dental
POSTGRES_PASSWORD=your_secure_password_here

# Backend (for local development without Docker)
# DATABASE_URL is auto-constructed in docker-compose.yml
DATABASE_URL=postgresql+asyncpg://dental:your_secure_password_here@localhost:5432/dental_clinic

# Security - Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_use_openssl_rand_hex_32

# Independent secret for the public-budget verification cookie
# (see docs/adr/0006-budget-public-link-2-factor-auth.md).
# Generate with: openssl rand -hex 32. Falls back to SECRET_KEY in
# dev when unset; production deploys must set it explicitly.
BUDGET_PUBLIC_SECRET_KEY=

# Error tracking (optional). Sentry-protocol DSN — Sentry or self-hosted
# GlitchTip. Empty = off. Bodies, cookies, IPs and URL identifiers are
# never sent; a cloud backend still needs a DPA (see
# docs/technical/compliance-posture.md). Tracing is a second opt-in:
# 0.0 = off, spans carry SQL text.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# Environment
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000
# Session cookies are host-only unless the app and the API live on different
# hosts of one parent domain; then set e.g. COOKIE_DOMAIN=.example.com
COOKIE_DOMAIN=
# Sistema TS (sistema_ts module): PEM bundle holding the private "Sogei
# Certification Authority Test" for the invioSS730pTest service; production
# needs nothing. Empty = the default certifi bundle.
SISTEMA_TS_CA_BUNDLE=
# Public demo instance: blocks user edits/removal and module
# install/uninstall/restart so one visitor can't break the demo for others.
DEMO_MODE=false

# Leads module — public intake endpoint (POST /api/v1/leads/public/intake).
# Only the request size ceiling is configuration. The daily cap is clinic
# data, edited at Settings -> Integrations -> "Formulario web" (default
# 200/day, 0 = unlimited) — there is deliberately no LEADS_INTAKE_DAILY_CAP.
LEADS_INTAKE_MAX_BODY_KB=8

# Frontend
API_BASE_URL=http://localhost:8000
